<!DOCTYPE html>
<html lang="en">

<%-include('./partials/head.ejs')%>


    <body class="body">

        <%-include('./partials/header.ejs')%>

            <main class="min">
                <section class="orden">
                    <h2>ARTICULOS MASCULINOS</h1>
                        <% for( let i=0; i < productos.length; i++ ) { %>
                            <% if(productos[i].genre=="Femenino" || productos[i].genre=="Unisex" ) { %>
                                <article class="publi">
                                    <img src="/<%- productos[i].img %>" alt="">
                                    <h4><%- productos[i].model %></h4>
                                    <h5>Genero: <%- productos[i].genre %></h5>
                                </article>
                            <% } %>
                        <% } %>
                </section>
            </main>
            <%-include('./partials/footer.ejs')%>
            <%-include('./partials/script.ejs')%>
    </body>

</html>