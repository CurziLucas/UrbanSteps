<!DOCTYPE html>
<html lang="en">

<%- include('./partials/head.ejs') %>

<body class="body">
    
    <%- include('./partials/header.ejs') %>
    <div class="pub">
        <section class="imagen">
            <img src="/<%- producto.img %>">
        </section>
        <section class="datos">
            <div>
                <h4>Lo Nuevo</h4>
                <h1><%- producto.name %></h1>
                <h5>Modelo <%- producto.model %></h5>
                <h5>Género <%- producto.genre %></h5>
                <h2> <%- producto.price %> usd</h2>
                <h5>Hasta 6 cuotas</h5>
                <p><%- producto.description %></p>
            </div>
            <div class="talle">
                <h3>Seleccione un talle</h3>
                <form action="admin.ejs">
                    <select name="sizes-selec" id="sizes">
                        <% for( let i = 0; i < producto.sizes.length; i++ ) { %>
                            <option value="<%- producto.sizes[i] %>"><%- producto.sizes[i] %></option>
                        <% } %>
                    </select>
                    <button type="submit">Agregar al carrito</button>
                </form>
            </div>
        </section>
    </div>
    <%-include('./partials/footer.ejs')%>
    <%- include('./partials/script.ejs') %>
</body>

</html>