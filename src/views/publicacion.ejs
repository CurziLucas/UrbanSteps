<!DOCTYPE html>
<html lang="en">

<%- include('./partials/head.ejs') %>

<body class="body">
    
    <%- include('./partials/header.ejs') %>
    <div class="pub">
        <section class="imagen">
            <img src="/assets/zapatillas/<%- producto.image %>" alt="<%- producto.name %>">
        </section>
        <section class="datos">
            <div>
                <h4>Lo Nuevo</h4>
                <h1><%- producto.name %></h1>
                <h5>Marca <%- producto.brand %></h5>
                <h5>Género <%- producto.genre %></h5>
                <h2> <%- producto.price %>$</h2>
                <h5>Hasta 6 cuotas</h5>
                <p><%- producto.description %></p>
            </div>
            <div class="talle">
                <h3>Seleccione un talle</h3>
                <form action="admin.ejs">
                    <select name="sizes-selec" id="sizes">
                        <% if (producto.sizes && producto.sizes.length > 0) { %>
                            <% for (let i = 0; i < producto.sizes.length; i++) { %>
                                <option value="<%= producto.sizes[i].value %>"><%= producto.sizes[i].value %></option>
                            <% } %>
                        <% } else { %>
                            <option disabled selected>No hay talles disponibles</option>
                        <% } %>
                    </select>
                    <button type="submit">Agregar al carrito</button>
                </form>
            </div>
        </section>
    </div>
    <%-include('./partials/footer.ejs')%>
    <%- include('./partials/script.ejs') %>
</body>

</html>