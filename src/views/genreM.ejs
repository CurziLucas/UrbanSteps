<!DOCTYPE html>
<html lang="en">

<%-include('./partials/head.ejs')%>


    <body class="body">

        <%-include('./partials/header.ejs')%>

            <main class="min">
                <section class="orden">
                    <h2>ARTICULOS MASCULINOS</h1>
                        <% for( let i=0; i < productos.length; i++ ) { %>
                            <% if(productos[i].genreId === 1 || productos[i].genreId === 3 ) { %>
                                <a href="/products/detalle/<%- productos[i].id %>" class="publi">
                                    <article>
                                        <img src="/assets/zapatillas/<%- productos[i].image%>" alt="<%- productos[i].name %>">
                                        <h4><%- productos[i].name %></h4>
                                        <h5>Genero: <%- productos[i].genreId %></h5>
                                    </article>
                                </a>
                            <% } %>
                        <% } %>
                </section>
            </main>
            <%-include('./partials/footer.ejs')%>
            <%-include('./partials/script.ejs')%>
    </body>

</html>