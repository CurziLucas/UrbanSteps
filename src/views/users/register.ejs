<!DOCTYPE html>
<html lang="en">

<%-include('../partials/head.ejs')%>

<body class="body">
    
    <%-include('../partials/header.ejs')%>

    <main>
        <section class="login">
            <p class="p-text">Ingrese sus datos para crear su cuenta.</p>
            <form action="/user/register" method="post" class="login">
                <% if (typeof errors != 'undefined') { %>
                    <ul>
                        <% errors.forEach(error => { %>
                            <li><%= error.msg %></li>
                        <% }) %>
                    </ul>
                <% } %>
                <div class="mb-3">
                    <input class="form-control form-control-lg rounded-pill mb-0" type="text" name="email" id="email" placeholder="Email">
                </div>
                <div class="mb-3">
                    <input class="form-control form-control-lg rounded-pill mb-0" type="text" name="username" id="user" placeholder="Usuario">
                </div>
                <div class="mb-3">
                    <input class="form-control form-control-lg rounded-pill mb-0" type="text" name="direction" id="direction" placeholder="direccion">
                </div>
                <div class="mb-3">
                    <input class="form-control form-control-lg rounded-pill mb-0" type="text" name="zipcode" id="zipcode" placeholder="Codigo postal">
                </div>
                <div class="mb-3">
                    <input class="form-control form-control-lg rounded-pill mb-0" type="password" name="password" id="password" placeholder="Contraseña">
                </div>
                <div class="mb-3">
                    <input class="form-control form-control-lg rounded-pill mb-0" type="password" name="repassword" id="repassword" placeholder="Repetir contraseña">
                </div>
                <div>
                    <button type="reset" id="button-perfil" class="btn btn-dark rounded-pill btn-md mt-0 custom-btn">Reiniciar</button>
                    <button type="submit" id="button-perfil" class="btn btn-dark rounded-pill btn-md mt-0 custom-btn">Crear cuenta</button>
                </div>
            </form>
        </section>
    </main>
    <%-include('../partials/script.ejs')%>
</body>
</html>