<!DOCTYPE html>
<html lang="en">

<%-include('../partials/head.ejs')%>

<body class="body">
    
    <%-include('../partials/header.ejs')%>

    <main>
        <section class="login">
            <p class="p-text">Ingrese sus datos para iniciar sesion.</p>
            <form action="/user/login" method="post" class="login">
                <% if (typeof errors != 'undefined') { %>
                    <ul>
                        <% errors.forEach(error => { %>
                            <li><%= error.msg %></li>
                        <% }) %>
                    </ul>
                <% } %>
                <div class="mb-3">
                    <input type="email" id="email" name="email" class="form-control form-control-lg rounded-pill" placeholder="Correo electrónico" required>
                </div>
                <div class="mb-3">
                    <input type="password" id="password" name="password" class="form-control form-control-lg rounded-pill mb-0" placeholder="Contraseña" required>
                </div>
                <div class="mb-3 form-check">
                    <input type="checkbox" id="remember" name="remember" class="form-check-input">
                    <label for="remember" class="form-check-label">Recordar mis datos</label>
                </div>
                <button class="btn btn-dark rounded-pill btn-md mt-0" type="submit" id="enviar">Iniciar sesion</button>
            </form>
            <p>Si no tienes cuenta, crea una <a href="/user/register">aqui!</a></p>
        </section>
    </main>
    <%-include('../partials/script.ejs')%>
</body>
</html>

    