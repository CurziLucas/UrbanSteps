<!DOCTYPE html>
<html lang="en">

<%-include('../partials/head.ejs')%>

    <body class="body">
        <%-include('../partials/header.ejs')%>
        <% if (locals.user != undefined) { %>
            <div class="foto">
                <% if (locals.user.avatar) { %>
                    <img src="/<%- locals.user.avatar %>" alt="Avatar">
                <% } else { %>
                    <i class="fa-solid fa-circle-user avatar"></i>
                <% } %>
            </div>
            <div class="info-todo">
                <div class="info-perfil">
                    <h1><%- locals.user.username %></h1>
                    <p>Email: <%- locals.user.email %></p>
                    <p>Direccion: <%- locals.user.direction %></p>
                    <p style="margin-bottom: 3vh;">codigo postal: <%- locals.user.zipcode %></p>
                    <a href="/user/editarperfil">
                        <button id="button-perfil" class="btn btn-dark rounded-pill btn-md mt-0 custom-btn">Editar perfil</button>
                    </a>
                </div>
            </div>
        <% } %>
            <%-include('../partials/script.ejs')%>
    </body>

</html>