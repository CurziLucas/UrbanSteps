<!DOCTYPE html>
<html lang="en">

<%-include('../partials/head.ejs')%>

    <body class="body">
        <%-include('../partials/header.ejs')%>
            <main>
                <section class="login">
                    <p>Completar datos del articulo</p>
                    <form action="/products/agregarproducto" class="login" method="post">
                        <input type="text" id="name"  name="name" placeholder="Nombre">
                        <input type="text" id="brand" name="brand" placeholder="Marca">
                        <input type="text" id="model" name="model" placeholder="Modelo">
                        <input type="text" id="genre" name="genre" placeholder="Genero">
                        <input type="number" id="price" name="price" placeholder="Precio">
                        <input type="text" id="description" name="description" placeholder="descripcion">
                        <div>
                            <button type="reset" id="Cancelar">Cancelar</button>
                            <button type="submit" id="Crear publicación">Crear publicación</button>
                        </div>
                    </form>
                </section>
            </main>
            <%-include('../partials/script.ejs')%>
        </body>
</html>