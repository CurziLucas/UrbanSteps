<!DOCTYPE html>
<html lang="en">

<%-include('../partials/head.ejs')%>

    <body class="body">
        <%-include('../partials/header.ejs')%>
            <main>
                <section class="login">
                    <p>Completar datos del articulo</p>
                    <form action="/products/agregarproducto" class="login" method="post">
                        <div class="mb-3">
                            <input class="form-control form-control-lg rounded-pill mb-0" type="text" id="name"  name="name" placeholder="Nombre">
                        </div>
                        <div class="mb-3">
                            <input class="form-control form-control-lg rounded-pill mb-0" type="text" id="brand" name="brand" placeholder="Marca">
                        </div>
                        <div class="mb-3">
                            <input class="form-control form-control-lg rounded-pill mb-0" type="text" id="model" name="model" placeholder="Modelo">
                        </div>
                        <div class="mb-3">
                            <input class="form-control form-control-lg rounded-pill mb-0" type="text" id="genre" name="genre" placeholder="Genero">
                        </div>
                        <div class="mb-3">
                            <input class="form-control form-control-lg rounded-pill mb-0" type="number" id="price" name="price" placeholder="Precio">
                        </div>
                        <div class="mb-3">
                            <input class="form-control form-control-lg rounded-pill mb-0" type="text" id="description" name="description" placeholder="descripcion">
                        </div>
                        <div>
                            <button type="reset" id="button-perfil" class="btn btn-dark rounded-pill btn-md mt-0 custom-btn">Cancelar</button>
                            <button type="submit" id="button-perfil" class="btn btn-dark rounded-pill btn-md mt-0 custom-btn">Crear publicación</button>
                        </div>
                    </form>
                </section>
            </main>
            <%-include('../partials/script.ejs')%>
        </body>
</html>