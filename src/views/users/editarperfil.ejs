<!DOCTYPE html>
<html lang="en">

<%-include('../partials/head.ejs')%>

<body class="body">
    
    <%-include('../partials/header.ejs')%>

    <main>
        <% if (user) { %>
            <section class="login">
                <p class="p-text">Ingrese sus datos para crear su cuenta.</p>
                <form action="/user/editarperfil/<%- user.id %>?_method=PUT" method="post" class="login">
                    <div class="mb-3">
                        <input class="form-control form-control-lg rounded-pill mb-0" type="text" name="email" id="email" value="<%- user.email %>">
                    </div>
                    <div class="mb-3">
                        <input class="form-control form-control-lg rounded-pill mb-0" type="text" name="username" id="user" value="<%- user.username %>">
                    </div>
                    <div class="mb-3">
                        <input class="form-control form-control-lg rounded-pill mb-0" type="text" name="direction" id="direction" value="<%- user.direction %>">
                    </div>
                    <div class="mb-3">
                        <input class="form-control form-control-lg rounded-pill mb-0" type="text" name="zipcode" id="zip-code" value="<%- user.zipcode %>">
                    </div>
                    <div class="mb-3">
                        <input class="form-control form-control-lg rounded-pill mb-0" type="password" name="newpassword" id="newpassword" placeholder="Nueva contraseña">
                    </div>
                    <div class="mb-3">
                        <input class="form-control form-control-lg rounded-pill mb-0" type="password" name="renewpassword" id="renewpassword" placeholder="Repetir nueva contraseña">
                    </div>
                    <div class="mb-3">
                        <input class="form-control form-control-lg rounded-pill mb-0" type="password" name="password" id="password" placeholder="Contraseña actual">
                    </div>
                    <div class="d-flex flex-column align-items-center gap-2">
                        <button id="button-perfil" type="reset" class="btn btn-dark rounded-pill btn-md mt-0 custom-btn">Cancelar</button>
                        <button id="button-perfil" type="submit" class="btn btn-dark rounded-pill btn-md mt-0 custom-btn">Cambiar datos</button>
                    </div>
                </form>
            </section>
        <% } %>
    </main>
    <%-include('../partials/script.ejs')%>
</body>
</html>