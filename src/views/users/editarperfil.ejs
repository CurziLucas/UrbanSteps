<!DOCTYPE html>
<html lang="en">

<%-include('../partials/head.ejs')%>

<body class="body">
    
    <%-include('../partials/header.ejs')%>

    <main>
        <% if (locals.user != undefined) { %>
            <section class="login">
                <p>Ingrese sus datos para crear su cuenta.</p>
                <form action="/user/editarperfil" method="post" class="login">
                    <input type="text" name="email" id="email" value="<%- locals.user.email %>">
                    <input type="text" name="username" id="user" value="<%- locals.user.username %>">
                    <input type="text" name="direction" id="direction" value="<%- locals.user.direction %>">
                    <input type="text" name="zipcode" id="zip-code" value="<%- locals.user.zipcode %>">
                    <input type="password" name="newpassword" id="newpassword" placeholder="Nueva contraseña">
                    <input type="password" name="renewpassword" id="renewpassword" placeholder="Repetir nueva contraseña">
                    <input type="password" name="password" id="password" placeholder="Contraseña actual">
                    <div>
                        <button type="reset" id="reset">cancelar</button>
                        <button type="submit" id="enviar">Cambiar datos</button>
                    </div>
                </form>
            </section>
        <% } %>
    </main>
    <%-include('../partials/script.ejs')%>
</body>
</html>