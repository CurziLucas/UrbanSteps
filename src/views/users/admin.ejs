<!DOCTYPE html>
<html lang="en">

<%-include('../partials/head.ejs')%>

<body class="body">

    <%-include('../partials/header.ejs')%>

    <h2>Productos</h2>
    <a href="/products/agregarproducto">
        <input type="button" class="boton-artic" value="Agregar nuevo producto">
    </a>
    <table>
        <thead>
            <tr>
                <th>id</th>
                <th>Marca</th>
                <th>Modelo</th>
                <th>Precio</th>
                <th>Genero</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <% for( let i = 0; i < productos.length; i++ ) { %>
                <tr>
                    <td><%- productos[i].id %></td>
                    <td><%- productos[i].brand %></td>
                    <td><%- productos[i].model %></td>
                    <td><%- productos[i].price %></td>
                    <td><%- productos[i].genre %></td>
                    <td>
                        <input type="button" value="Editar">
                        <input type="button" value="Eliminar">
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>

    <%-include('../partials/script.ejs')%>
</body>
</html>